# VeritasCore Environment Variables
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# ── Search API Keys ───────────────────────────────────────────────────────────
# At least one required for ungrounded verification mode.
# Tavily: https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxx

# Brave Search: https://brave.com/search/api/ (free tier: 2000 queries/month)
BRAVE_API_KEY=BSAxxxxxxxxxxxxx

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required only for gated models (e.g. Llama). Optional for Phi-3/Qwen.
HF_TOKEN=hf_xxxxxxxxxxxxx

# ── Experiment Tracking (Optional) ───────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=veritascore
WANDB_ENTITY=

# ── Engine Configuration ──────────────────────────────────────────────────────
# Device: auto (recommended), cuda, cpu
VERITASCORE_DEVICE=auto

# Log level: DEBUG, INFO, WARNING, ERROR
VERITASCORE_LOG_LEVEL=INFO

# ── Cache Paths ───────────────────────────────────────────────────────────────
VERITASCORE_CACHE_DIR=.cache
VERITASCORE_DATASET_DIR=data/datasets
